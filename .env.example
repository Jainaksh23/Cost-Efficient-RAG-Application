# ── Paths ─────────────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=data/faiss.index
SQLITE_DB_PATH=data/rag_metadata.db

# ── Chunking ──────────────────────────────────────────────────────────────────
# Window size in characters (approx 512 tokens at 4 chars/token)
CHUNK_SIZE=2048
# Overlap between consecutive chunks in characters
CHUNK_OVERLAP=256

# ── Embedding ─────────────────────────────────────────────────────────────────
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_BATCH_SIZE=64

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=5
MIN_SIMILARITY_THRESHOLD=0.25

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Uncomment to write logs to a file as well as stdout:
# LOG_FILE=logs/app.log

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Groq (required for generation + LLM-as-judge eval) ────────────────────────
# Do NOT commit real keys. Set this in a real .env that is gitignored.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_JUDGE_MODEL=llama-3.3-70b-versatile

# ── Evaluation harness ────────────────────────────────────────────────────────
EVAL_QUESTIONS_PATH=eval/questions.jsonl
EVAL_RESULTS_PATH=eval/results.json
